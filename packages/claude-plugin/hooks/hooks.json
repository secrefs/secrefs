{
  "description": "Block Write/Edit/MultiEdit/NotebookEdit calls that would put a literal secret into a file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
